LexiDesk/models/**/*.pth
LexiDesk/models/**/*.joblib
LexiDesk/models/**/*.bin
LexiDesk/models/**/checkpoints/

# --- ALLOW ONLY RHETORICAL HIERARCHICAL_BILSTM_CRF MODEL ARTIFACTS ---
!LexiDesk/models/rhetorical/
!LexiDesk/models/rhetorical/hierarchical_bilstm_crf/

!LexiDesk/models/rhetorical/hierarchical_bilstm_crf/final_model.pt
