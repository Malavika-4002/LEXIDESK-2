!LexiDesk/models/rhetorical/hierarchical_bilstm_crf/vocab.joblib
!LexiDesk/models/rhetorical/hierarchical_bilstm_crf/label_encoder.joblib
!LexiDesk/models/rhetorical/hierarchical_bilstm_crf/checkpoint.pth


# --- ALLOW ONLY RHETORICAL HIERARCHICAL_BILSTM_SAFE MODEL ARTIFACTS --- USING SOFTMAX WITH HIERARCHICAL BILSTM
!LexiDesk/models/rhetorical/
!LexiDesk/models/rhetorical/hierarchical_bilstm_safe/

